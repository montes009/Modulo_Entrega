-- 0002_rpc_entregas_equipo.sql.example
-- PLANTILLA (no ejecutar tal cual) de las RPCs SECURITY DEFINER que son la ÚNICA vía de
-- escritura sensible. Completar la lógica real y probar por impersonación + rollback
-- (Manual 3.5) ANTES de que el frontend dependa de ellas.
--
-- Recordatorios de seguridad (Manual sec. 3):
--   * Validar SIEMPRE: empresa dueña, rol autorizado, estado válido, campos obligatorios.
--   * REVOKE que de verdad revoca:  REVOKE ... FROM PUBLIC;  no FROM anon.
--   * Verificar con has_function_privilege('anon', p.oid, 'EXECUTE').
--   * Orden de despliegue: crear RPC → probar → desplegar JS → recién ahí revocar
--     el INSERT/UPDATE directo sobre la tabla.

-- ---------- crear_entrega_equipo ----------
create or replace function public.crear_entrega_equipo(
  p_equipo_id text,
  p_cliente_nombre text,
  p_recibido_por text
) returns uuid
language plpgsql
security definer
set search_path = public
as $$
declare
  v_empresa uuid := public.get_empresa_id_actual();
  v_id uuid;
begin
  if v_empresa is null then
    raise exception 'usuario sin empresa';
  end if;
  -- (validar rol autorizado aquí)
  insert into public.entregas_equipo(empresa_id, equipo_id, cliente_nombre,
                                     entregado_por, recibido_por, estado)
  values (v_empresa, p_equipo_id, p_cliente_nombre, auth.uid(), p_recibido_por, 'borrador')
  returning id into v_id;
  return v_id;
end $$;

-- ---------- cerrar_checklist (borrador → en_proceso) ----------
-- Valida que TODOS los ítems obligatorios estén respondidos y con foto si la exigen.

-- ---------- registrar_firma (única vía de escritura de entregas_equipo_firmas) ----------
-- Valida checklist completo, acta no firmada/anulada; al recibir la 2ª firma pasa el acta
-- a 'firmada' en la MISMA transacción (nunca dos pasos separados).

-- ---------- anular_entrega (motivo obligatorio, rol autorizado) ----------

-- ================= REVOKE/GRANT correctos (aplicar tras desplegar el JS) =================
-- revoke execute on function public.crear_entrega_equipo(text,text,text) from public;
-- grant  execute on function public.crear_entrega_equipo(text,text,text) to authenticated;
-- (repetir por cada RPC; verificar con has_function_privilege)
